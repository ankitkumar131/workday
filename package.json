{
  "name": "workday-smart-autofill",
  "version": "1.0.0",
  "private": true,
  "description": "Intelligent Multi-Step Job Application Browser Extension for Workday",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build && node scripts/build-extension.mjs",
